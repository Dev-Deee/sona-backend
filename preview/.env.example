# Copy to .env (never commit it).

# Public hostname testers will open. No domain yet? Use your server's IP with sslip.io,
# e.g. 203-0-113-10.sslip.io — Caddy still gets a real HTTPS certificate for it.
# For a quick local try, use: localhost
SONA_DOMAIN=203-0-113-10.sslip.io

# openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes

# openssl rand -base64 24
POSTGRES_PASSWORD=replace-me

# Which images to run: develop (latest merged work) or main (released).
SONA_TAG=develop
